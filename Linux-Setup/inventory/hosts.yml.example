# EXAMPLE INVENTORY - Copy to hosts.yml and customize with your actual IPs
# DO NOT commit real IP addresses or hostnames to version control

linux:
  children:
    debian:
      children:
        newpi:
          children:
            pi:
              hosts:
                192.168.1.100:  # EXAMPLE-NEW-PI-01
                # 192.168.1.101:  # EXAMPLE-NEW-PI-02
              vars:
                ansible_user: "pi"
                ansible_ssh_private_key_file: "~/.ssh/pi_key"

        rpi:
          children:
            pi:
              hosts:
                # Example production Pi devices
                # 192.168.1.10:   # EXAMPLE-PRODUCTION-PI-01
                # 192.168.1.11:   # EXAMPLE-PRODUCTION-PI-02
                # 192.168.1.12:   # EXAMPLE-NTP-PI
                # 192.168.1.20:   # EXAMPLE-MESH-PI-01
                # 192.168.1.21:   # EXAMPLE-MESH-PI-02
                # 192.168.1.30:   # EXAMPLE-KUBE-CP-01
                # 192.168.1.31:   # EXAMPLE-KUBE-CP-02
                # 192.168.1.32:   # EXAMPLE-KUBE-CP-03
                # 192.168.1.40:   # EXAMPLE-KUBE-WK-01
                # 192.168.1.41:   # EXAMPLE-KUBE-WK-02
                # 192.168.1.42:   # EXAMPLE-KUBE-WK-03
              vars:
                ansible_user: "pi"
                ansible_ssh_private_key_file: "~/.ssh/pi_key"

            # Example: Additional user group
            # admin_user:
            #   hosts:
            #     192.168.1.50:  # EXAMPLE-ADMIN-PI-01
            #     192.168.1.51:  # EXAMPLE-ADMIN-PI-02
            #   vars:
            #     ansible_user: "your_username"
            #     ansible_ssh_private_key_file: "~/.ssh/your_username_key"

            # Example: Service-specific group
            # pihole:
            #   hosts:
            #     192.168.1.60:  # EXAMPLE-PIHOLE-01
            #     192.168.1.61:  # EXAMPLE-PIHOLE-02
            #   vars:
            #     ansible_user: "your_username"
            #     ansible_ssh_private_key_file: "~/.ssh/your_username_key"
            #     pihole_enabled: "true"
