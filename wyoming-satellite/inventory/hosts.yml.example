---
# Wyoming Satellite Inventory Configuration - EXAMPLE
# Copy this file to hosts.yml and customize with your actual hosts

wyoming_satellites:
  hosts:
    # Wyoming Satellite voice assistant nodes (Raspberry Pi with ReSpeaker HAT)
    # 10.10.2.50:  # wyoming-satellite-01
    # 10.10.2.51:  # wyoming-satellite-02
  vars:
    ansible_user: "wyoming"
    ansible_ssh_private_key_file: "~/.ssh/wyoming_key"
